# linux-tuners.dev — environment configuration template
#
# Copy this file to `.env.local` (or `.env.production.local` for prod-only)
# and fill in real values. Files matching `.env*.local` are gitignored.
#
# Only variables prefixed with VITE_ are exposed to client code at build time.

# Google AdSense publisher ID (format: "ca-pub-XXXXXXXXXXXXXXXX").
# Leave empty in development — the AdSlot component renders a labelled
# placeholder when this is unset, and the cookie banner stays hidden.
VITE_ADSENSE_CLIENT=

# Per-slot IDs from the AdSense console. Each <AdSlot slot="..."> references
# one of these keys. Add a new env var here when you place a new AdSlot.
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_SWAP=
