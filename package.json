{
  "name": "linux-tuners",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "linux-tuners.dev — interactive, hardware-aware tuners for Linux system configuration (swap, systemd, …) with live impact graphs and copy-pasteable configs.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-static-routes.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vm": "vitest run --config vitest.vm.config.js"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "lz-string": "^1.5.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "4.14.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
