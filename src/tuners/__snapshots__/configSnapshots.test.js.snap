exports[`generated config: security > container / cis 1`] = `
"# ────────────────────────────────────────────────────────────────────────────
# Linux security hardening sysctls
# Generated 2026-01-01 by linux-tuners.dev/security
# System: Container host or Kubernetes node, kernel 5.13 or newer, IPv6 on
# Profile: CIS-style server
# ────────────────────────────────────────────────────────────────────────────
#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-security-hardening.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#    Test on one machine first: some values can break debuggers,
#    profilers, VPNs or container networking (see the notes per key).
#
# 3. Verify a value took effect:
#      sysctl kernel.kptr_restrict
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-security-hardening.conf
#
# NETWORK INTERFACES
#
# The conf.all and conf.default keys below don't reach every interface
# that exists when this file is applied: an IPv4 interface whose own
# value was set (systemd sets rp_filter on each one) keeps it, and IPv6
# interfaces always keep theirs. For IPv4 redirects the kernel honours
# either the conf.all or the interface value. Check the interfaces after
# applying:
#   sysctl -a 2>/dev/null | grep -E '\\.(rp_filter|accept_redirects|send_redirects)'
#
# Strict rp_filter: the kernel uses the higher of conf.all and the
# interface value, and systemd sets every interface to 2 (loose).
# NetworkManager also sets each interface it manages back to 2 when it
# brings the connection up, so strict mode doesn't hold where it runs.
#
# IPv6 redirects: the kernel only reads each interface's own value, so
# interfaces that exist before this file is applied (often the main one
# at boot) keep accepting redirects.
#
# To cover every interface, add these lines to the end of this file:
#   net.ipv4.conf.*.rp_filter = 1
#   net.ipv6.conf.*.accept_redirects = 0
# systemd 245 and newer (systemctl --version) apply them at boot and to
# each interface as it appears; apply them now with
#   sudo systemctl restart systemd-sysctl
# since sysctl from procps before 4.0 rejects them. Older systemd skips
# them: name each interface instead, e.g. net.ipv4.conf.eth0.rp_filter.
#
# ────────────────────────────────────────────────────────────────────────────
#
# UBUNTU: apport sets fs.suid_dumpable to 2 each time it starts, which
# is after this file is applied. To keep 0, turn apport off:
#   sudo systemctl disable --now apport
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   Kernel sysctl docs: https://docs.kernel.org/admin-guide/sysctl/
#   IP sysctls: https://docs.kernel.org/networking/ip-sysctl.html
#   KSPP recommended settings: https://kspp.github.io/Recommended_Settings

# ── Kernel information and attack surface ───────────────────────────────────
# kptr_restrict: 1 - kernel pointers hidden without CAP_SYSLOG
kernel.kptr_restrict = 1

# dmesg_restrict: 1 - kernel log needs CAP_SYSLOG
kernel.dmesg_restrict = 1

# perf_event_paranoid: 2 - users may profile the user space of their own processes
kernel.perf_event_paranoid = 2

# ptrace_scope: 1 - ptrace only of descendants
kernel.yama.ptrace_scope = 1

# randomize_va_space: 2 - full ASLR
kernel.randomize_va_space = 2

# unprivileged_bpf_disabled: 2 - unprivileged bpf() off
kernel.unprivileged_bpf_disabled = 2

# ── Network ─────────────────────────────────────────────────────────────────
# rp_filter: 1 - strict reverse-path filtering (RFC 3704)
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

# tcp_syncookies: 1 - SYN cookies when the listen queue overflows
net.ipv4.tcp_syncookies = 1

# accept_redirects: 0 - ignore ICMP redirects
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# accept_redirects_v6: 0 - ignore ICMP redirects
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0

# send_redirects: 0 - never send ICMP redirects
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

# accept_source_route: 0 - drop source-routed packets
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0

# ── Filesystem links and core dumps ─────────────────────────────────────────
# protected_symlinks: 1 - restrict following symlinks in sticky dirs
fs.protected_symlinks = 1

# protected_hardlinks: 1 - restrict hard links to others' files
fs.protected_hardlinks = 1

# protected_fifos: 1 - protect FIFOs in world-writable sticky dirs
fs.protected_fifos = 1

# protected_regular: 1 - protect files in world-writable sticky dirs
fs.protected_regular = 1

# suid_dumpable: 0 - no core dumps of privileged processes
fs.suid_dumpable = 0"
`;

