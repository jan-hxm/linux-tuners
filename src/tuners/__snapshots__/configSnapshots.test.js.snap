exports[`generated config: block-io > streaming / interactive 1`] = `
"# ────────────────────────────────────────────────────────────────────────────
# Linux block I/O queue settings, as udev rules
# Generated 2026-01-01 by linux-tuners.dev/block-io
# System: NVMe SSD, File, media or backup server, BFQ and Kyber available
# Profile: Interactive (BFQ)
# ────────────────────────────────────────────────────────────────────────────
#
# The rules below apply to every NVMe namespace (nvme0n1, nvme1n1, ...),
# at boot, when one is plugged in, and when the rules are triggered.
#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a rules file:
#      sudo nano /etc/udev/rules.d/99-block-tuning-nvme.rules   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo udevadm control --reload
#      sudo udevadm trigger --action=change --subsystem-match=block
#      sudo udevadm settle
#
# 3. Verify they took effect, and that udev wrote every value:
#      lsblk -d -o NAME,ROTA,SCHED,RQ-SIZE,RA
#      journalctl -b -u systemd-udevd | grep "Failed to write"
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/udev/rules.d/99-block-tuning-nvme.rules
#
# NOTES
#
# udev writes each value when the rule runs. A value the kernel refuses,
# such as a scheduler it lacks, is logged ("Failed to write") and
# skipped; the rest still apply.
#
# queue/nr_requests is left out, so it keeps the value the kernel sets
# with the scheduler: twice the queue depth, at most 256.
#
# queue/read_ahead_kb is left out at 128 KiB, so a device the kernel
# starts higher keeps its value (Fedora 43 starts virtio disks at 8192).
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   queue attributes: https://docs.kernel.org/admin-guide/abi-stable.html
#   BFQ:              https://docs.kernel.org/block/bfq-iosched.html
#   udev rules:       https://www.freedesktop.org/software/systemd/man/latest/udev.html

# ── I/O scheduler ───────────────────────────────────────────────────────────
# scheduler: bfq - the I/O scheduler
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="nvme[0-9]*n[0-9]*", ENV{DEVTYPE}=="disk", ATTR{queue/scheduler}="bfq""
`;

