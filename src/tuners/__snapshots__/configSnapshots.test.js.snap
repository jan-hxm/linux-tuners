# ===== /etc/systemd/system.conf.d/99-resource-tuning.conf ===================
[Manager]
# DefaultCPUAccounting: left out, cgroup v2 always accounts CPU time (systemd 258 removed the option)
# DefaultMemoryAccounting: per-unit memory accounting (units with a limit count either way)
DefaultMemoryAccounting=yes
# DefaultIOAccounting: per-unit block-I/O accounting
DefaultIOAccounting=yes
# DefaultTasksAccounting: per-unit task counting (units with a TasksMax count either way)
DefaultTasksAccounting=yes
# DefaultIPAccounting: per-unit network accounting (eBPF)
DefaultIPAccounting=no
# DefaultTasksMax: default per-unit task cap (~25% of pid_max)
DefaultTasksMax=1048576
# DefaultLimitNOFILE: default open-file-descriptor soft:hard limit
DefaultLimitNOFILE=1024:1048576
# DefaultLimitMEMLOCK: default locked-in-memory ceiling
DefaultLimitMEMLOCK=8M

# ===== /etc/systemd/system/system.slice.d/50-resources.conf =================
[Slice]
# CPUWeight: proportional CPU share under contention (default 100)
CPUWeight=200
# CPUQuota: unset (no hard CPU limit)
# MemoryHigh: soft throttle limit ≈ 12.8 GiB of 16
MemoryHigh=80%
# MemoryMax: hard OOM limit ≈ 14.4 GiB of 16
MemoryMax=90%
# MemorySwapMax: unset (infinity, slice may swap freely)
# IOWeight: proportional block-I/O share under contention (default 100)
IOWeight=200
# TasksMax: hard task cap for the whole slice (~0.5% of pid_max)
TasksMax=19660"
`;

exports[`generated config: systemd > kubernetes / systemd-defaults 1`] = `
"# systemd resource tuning (generated 2026-01-01)
# Profile: Kubernetes node, system.slice, 16 GiB RAM, 8 cores, cgroup v2
# Preset: systemd defaults
# Apply: sudo systemctl daemon-reload
#        manager defaults also need: sudo systemctl daemon-reexec (or a reboot)
# To undo, delete these files and reload systemd:
#      sudo rm /etc/systemd/system.conf.d/99-resource-tuning.conf
#      sudo rm /etc/systemd/system/system.slice.d/50-resources.conf
#      sudo systemctl daemon-reexec
# Sources:
#   https://www.freedesktop.org/software/systemd/man/latest/systemd-system.conf.html
#   https://www.freedesktop.org/software/systemd/man/latest/systemd.resource-control.html

# ===== /etc/systemd/system.conf.d/99-resource-tuning.conf ===================
[Manager]
# DefaultCPUAccounting: left out, cgroup v2 always accounts CPU time (systemd 258 removed the option)
# DefaultMemoryAccounting: per-unit memory accounting (units with a limit count either way)
DefaultMemoryAccounting=yes
# DefaultIOAccounting: per-unit block-I/O accounting
DefaultIOAccounting=no
# DefaultTasksAccounting: per-unit task counting (units with a TasksMax count either way)
DefaultTasksAccounting=yes
# DefaultIPAccounting: per-unit network accounting (eBPF)
DefaultIPAccounting=no
# DefaultTasksMax: default per-unit task cap (~0.5% of pid_max)
DefaultTasksMax=19660
# DefaultLimitNOFILE: default open-file-descriptor soft:hard limit
DefaultLimitNOFILE=1024:524288
# DefaultLimitMEMLOCK: default locked-in-memory ceiling
DefaultLimitMEMLOCK=8M

# ===== /etc/systemd/system/system.slice.d/50-resources.conf =================
[Slice]
# CPUWeight: proportional CPU share under contention (default 100)
CPUWeight=100
# CPUQuota: unset (no hard CPU limit)
# MemoryHigh: unset (infinity, no throttle)
# MemoryMax: unset (infinity, no limit)
# MemorySwapMax: unset (infinity, slice may swap freely)
# IOWeight: proportional block-I/O share under contention (default 100)
IOWeight=100
# TasksMax: hard task cap for the whole slice (~0.5% of pid_max)
TasksMax=19660"
`;

exports[`generated config: sysv-ipc > container / defaults 1`] = `
"# ────────────────────────────────────────────────────────────────────────────
# Linux System V IPC sysctls: shared memory, semaphores, message queues
# Generated 2026-01-01 by linux-tuners.dev/sysv-ipc
# System: Container host or Kubernetes node, 16 GiB RAM
# Profile: custom
# ────────────────────────────────────────────────────────────────────────────
#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-sysv-ipc-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify they took effect:
#      ipcs -l
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-sysv-ipc-tuning.conf
#
# NOTES
#
# kernel.shmmax and kernel.shmall are left out: since kernel 3.16 both
# default to 18446744073692774399, no limit, and any value lowers them.
#
# Every key is written, at the kernel default too. sysctl.d files load
# in name order and a 99- file after most others, so this one undoes
# lower values an older guide left in another file. Check for those:
#   grep -rs "kernel\\.\\(shm\\|sem\\|msg\\)" /etc/sysctl.conf /etc/sysctl.d
#
# Each container gets its own IPC namespace, which starts at the kernel
# defaults, not at these values: set them per container instead.
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   kernel sysctls: https://docs.kernel.org/admin-guide/sysctl/kernel.html
#   kernel.sem: https://man7.org/linux/man-pages/man5/proc_sys_kernel.5.html

# ── Shared memory ───────────────────────────────────────────────────────────
# shmmni: 4096 - shared memory segments system-wide
kernel.shmmni = 4096

# shm_rmid_forced: 0 - segments stay until removed
kernel.shm_rmid_forced = 0

# ── Semaphores ──────────────────────────────────────────────────────────────
# sem: 32000 1024000000 500 32000 - per array, system-wide, ops per semop(), arrays
kernel.sem = 32000 1024000000 500 32000

# ── Message queues ──────────────────────────────────────────────────────────
# msgmni: 32000 - message queues system-wide
kernel.msgmni = 32000

# msgmax: 8192 - largest message in bytes
kernel.msgmax = 8192

# msgmnb: 16384 - bytes per queue, up to 500 MiB if every queue fills
kernel.msgmnb = 16384"
`;

