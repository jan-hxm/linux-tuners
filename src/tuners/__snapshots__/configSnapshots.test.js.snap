# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-swap-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify a value took effect:
#      sysctl vm.swappiness
#
# ACTIVATING SWAP: 8 GiB on NVMe
#
# If you do not have swap yet, a swap file is the simplest option:
#   sudo fallocate -l 8G /swapfile        # fallback: sudo dd if=/dev/zero of=/swapfile bs=1M count=8192
#   sudo chmod 600 /swapfile
#   sudo mkswap /swapfile
#   sudo swapon /swapfile
#
# Persist it across reboots by adding it to /etc/fstab:
#   echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
#
# Confirm it is active:  swapon --show && free -h
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   Kernel vm docs: https://docs.kernel.org/admin-guide/sysctl/vm.html

# ── Memory reclaim & swap ───────────────────────────────────────────────────
