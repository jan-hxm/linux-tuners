#      sudo sysctl --system
#
# 3. Verify they took effect:
#      ipcs -l
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-sysv-ipc-tuning.conf
#
# NOTES
#
# kernel.shmmax and kernel.shmall are left out: since kernel 3.16 both
# default to 18446744073692774399, no limit, and any value lowers them.
#
# Every key is written, at the kernel default too. sysctl.d files load
# in name order and a 99- file after most others, so this one undoes
# lower values an older guide left in another file. Check for those:
#   grep -rs "kernel\\.\\(shm\\|sem\\|msg\\)" /etc/sysctl.conf /etc/sysctl.d
#
# Db2 raises these to its minimums when an instance starts, but not at
# boot; this file makes them hold from boot.
#
# Each container gets its own IPC namespace, which starts at the kernel
# defaults, not at these values: set them per container instead.
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   kernel sysctls: https://docs.kernel.org/admin-guide/sysctl/kernel.html
#   kernel.sem: https://man7.org/linux/man-pages/man5/proc_sys_kernel.5.html

# ── Shared memory ───────────────────────────────────────────────────────────
# shmmni: 4096 - shared memory segments system-wide
kernel.shmmni = 4096

# shm_rmid_forced: 0 - segments stay until removed
kernel.shm_rmid_forced = 0

# ── Semaphores ──────────────────────────────────────────────────────────────
# sem: 32000 1024000000 500 32000 - per array, system-wide, ops per semop(), arrays
kernel.sem = 32000 1024000000 500 32000

# ── Message queues ──────────────────────────────────────────────────────────
# msgmni: 32000 - message queues system-wide
kernel.msgmni = 32000

# msgmax: 65536 - largest message in bytes
kernel.msgmax = 65536

# msgmnb: 65536 - bytes per queue, up to 2 GiB if every queue fills
kernel.msgmnb = 65536"
`;

