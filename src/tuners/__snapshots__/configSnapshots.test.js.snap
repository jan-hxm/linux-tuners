exports[`generated config: filesystem > desktop / defaults 1`] = `
"# ────────────────────────────────────────────────────────────────────────────
# Linux filesystem and file-descriptor sysctls
# Generated 2026-01-01 by linux-tuners.dev/filesystem
# System: Desktop or developer workstation, 16 GiB RAM, systemd 240 or newer
# Profile: custom
# ────────────────────────────────────────────────────────────────────────────
#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-filesystem-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify a value took effect:
#      sysctl fs.inotify.max_user_watches
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-filesystem-tuning.conf
#
# NOTES
#
# fs.file-max is left out: systemd 240 and newer raise it to
# 9223372036854775807, the maximum, at boot, and a value here would
# lower it.
#
# fs.nr_open is left out at the kernel default, 1048576, so systems
# where systemd starts it higher (Debian 13, Fedora) keep their value.
#
# The inotify limits count per user ID: every process of one user,
# containers running as that user included, shares them.
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   fs sysctls: https://docs.kernel.org/admin-guide/sysctl/fs.html
#   inotify limits: https://man7.org/linux/man-pages/man7/inotify.7.html

# ── inotify file watching ───────────────────────────────────────────────────
# max_user_watches: 524288 - inotify watches per user, up to about 665 MiB of kernel memory
fs.inotify.max_user_watches = 524288

# max_user_instances: 1024 - inotify instances per user
fs.inotify.max_user_instances = 1024

# max_queued_events: 65536 - events queued per inotify instance before overflow
fs.inotify.max_queued_events = 65536

# ── Asynchronous I/O ────────────────────────────────────────────────────────
# aio_max_nr: 65536 - native AIO requests across all processes
fs.aio-max-nr = 65536"
`;

