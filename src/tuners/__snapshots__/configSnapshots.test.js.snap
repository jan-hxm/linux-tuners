# Hardware: 16 GiB RAM, 8 GiB NVMe swap, Kubernetes node
# Profile: Memory-constrained
# ────────────────────────────────────────────────────────────────────────────
#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-swap-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify a value took effect:
#      sysctl vm.swappiness
#
# ACTIVATING SWAP: 8 GiB on NVMe
#
# If you do not have swap yet, a swap file is the simplest option:
#   sudo fallocate -l 8G /swapfile        # fallback: sudo dd if=/dev/zero of=/swapfile bs=1M count=8192
#   sudo chmod 600 /swapfile
#   sudo mkswap /swapfile
#   sudo swapon /swapfile
#
# Persist it across reboots by adding it to /etc/fstab:
#   echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
#
# Confirm it is active:  swapon --show && free -h
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   Kernel vm docs: https://docs.kernel.org/admin-guide/sysctl/vm.html
#   Kubernetes swap: https://kubernetes.io/blog/2025/08/19/tuning-linux-swap-for-kubernetes-a-deep-dive/

# ── Memory reclaim & swap ───────────────────────────────────────────────────
# swappiness: 30 - balanced bias between page cache and swap
vm.swappiness = 30

# min_free_kbytes: 8192 - reserve ~8 MiB as the kernel free-memory floor
vm.min_free_kbytes = 8192

# watermark_scale_factor: 10 - kswapd reclaim window ~16 MiB wide
vm.watermark_scale_factor = 10

# vfs_cache_pressure: 100 - balanced dentry/inode vs page-cache reclaim
vm.vfs_cache_pressure = 100

# ── Dirty page writeback ────────────────────────────────────────────────────
# dirty_ratio: 30 - synchronous stall ceiling at 30% of available memory dirtied
vm.dirty_ratio = 30

# dirty_background_ratio: 15 - background flusher wakes at 15% of available memory dirtied
vm.dirty_background_ratio = 15

# dirty_expire_centisecs: 3000 - dirty pages eligible for flush after 30.0 s
vm.dirty_expire_centisecs = 3000

# dirty_writeback_centisecs: 500 - flusher wakes every 5.0 s
vm.dirty_writeback_centisecs = 500

# ── OOM & overcommit ────────────────────────────────────────────────────────
# overcommit_memory: 0 - heuristic, kernel default
vm.overcommit_memory = 0

# panic_on_oom: 0 - invoke OOM killer (default)
vm.panic_on_oom = 0"
`;

exports[`generated config: systemd > container-host / container-host 1`] = `
"# systemd resource tuning (generated 2026-01-01)
# Profile: container host, system.slice, 16 GiB RAM, 8 cores, cgroup v2
# Preset: Container host
# Apply: sudo systemctl daemon-reload
#        manager defaults also need: sudo systemctl daemon-reexec (or a reboot)
# Sources:
#   https://www.freedesktop.org/software/systemd/man/latest/systemd-system.conf.html
#   https://www.freedesktop.org/software/systemd/man/latest/systemd.resource-control.html

# ===== /etc/systemd/system.conf.d/99-resource-tuning.conf ===================
[Manager]
# DefaultCPUAccounting: left out, cgroup v2 always accounts CPU time (systemd 258 removed the option)
# DefaultMemoryAccounting: per-unit memory accounting (required for memory limits)
DefaultMemoryAccounting=yes
# DefaultIOAccounting: per-unit block-I/O accounting
DefaultIOAccounting=yes
# DefaultTasksAccounting: per-unit task counting (required for TasksMax)
DefaultTasksAccounting=yes
# DefaultIPAccounting: per-unit network accounting (eBPF)
DefaultIPAccounting=no
# DefaultTasksMax: default per-unit task cap (~25% of pid_max)
DefaultTasksMax=1048576
# DefaultLimitNOFILE: default open-file-descriptor soft:hard limit
DefaultLimitNOFILE=1024:1048576
# DefaultLimitMEMLOCK: default locked-in-memory ceiling
DefaultLimitMEMLOCK=8M

# ===== /etc/systemd/system/system.slice.d/50-resources.conf =================
[Slice]
# CPUWeight: proportional CPU share under contention (default 100)
CPUWeight=100
# CPUQuota: unset (no hard CPU limit)
# MemoryHigh: soft throttle limit ≈ 12.8 GiB of 16
MemoryHigh=80%
# MemoryMax: hard OOM limit ≈ 14.4 GiB of 16
MemoryMax=90%
# MemorySwapMax: unset (infinity, slice may swap freely)
# IOWeight: proportional block-I/O share under contention (default 100)
IOWeight=100
# TasksMax: hard task cap for the whole slice (~15% of pid_max)
TasksMax=629146"
`;

