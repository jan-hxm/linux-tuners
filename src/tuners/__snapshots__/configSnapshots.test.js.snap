exports[`generated config: hugepages > database / defaults 1`] = `
"# ────────────────────────────────────────────────────────────────────────────
# Linux huge pages, THP, KSM and memory map sysctls
# Generated 2026-01-01 by linux-tuners.dev/hugepages
# System: Database server, 16 GiB RAM, one NUMA node
# Profile: custom
# ────────────────────────────────────────────────────────────────────────────
#
# HOW TO APPLY THESE SETTINGS
#
# This output is two files. Each starts at its "# =====" banner.
#
# 1. Persist them. Save each part as its own file:
#      sudo nano /etc/sysctl.d/99-hugepages-tuning.conf
#      sudo nano /etc/tmpfiles.d/99-hugepages-tuning.conf
#    The first loads with the sysctl files on boot; systemd-tmpfiles
#    writes the second to /sys on boot.
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#      sudo systemd-tmpfiles --create /etc/tmpfiles.d/99-hugepages-tuning.conf
#
# 3. Verify they took effect:
#      grep HugePages_ /proc/meminfo
#      cat /sys/kernel/mm/transparent_hugepage/enabled
#
# To undo, delete these files and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-hugepages-tuning.conf
#      sudo rm /etc/tmpfiles.d/99-hugepages-tuning.conf
#
# NOTES
#
# vm.nr_hugepages is left out at 0, so a pool set elsewhere (another
# sysctl.d file, or hugepages= on the kernel command line) stays.
#
# Debian kernels start transparent_hugepage/enabled at always, Ubuntu and
# Fedora at madvise; the second file sets it either way.
#
# Setting it to madvise makes khugepaged raise vm.min_free_kbytes to its
# own floor if it is lower, and systemd-tmpfiles runs after the sysctl
# files at boot. A lower vm.min_free_kbytes set elsewhere (such as the
# swap tuner's file) only holds with transparent huge pages set to never.
#
# ksm/run is left out while KSM is off, so a service that turns it on
# (such as ksmtuned) keeps working.
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   vm sysctls: https://docs.kernel.org/admin-guide/sysctl/vm.html
#   THP: https://docs.kernel.org/admin-guide/mm/transhuge.html
#   KSM: https://docs.kernel.org/admin-guide/mm/ksm.html
#   tmpfiles.d: https://www.freedesktop.org/software/systemd/man/latest/tmpfiles.d.html

# ===== /etc/sysctl.d/99-hugepages-tuning.conf ===============================
# ── Memory maps and NUMA ────────────────────────────────────────────────────
# max_map_count: 1048576 - memory mappings per process
vm.max_map_count = 1048576

# ===== /etc/tmpfiles.d/99-hugepages-tuning.conf =============================
# Each "w" line writes its value to that /sys file when systemd-tmpfiles
# runs at boot. A path the kernel lacks is skipped.

# ── Transparent huge pages ──────────────────────────────────────────────────
# thp_enabled: madvise - which memory gets transparent huge pages
w /sys/kernel/mm/transparent_hugepage/enabled - - - - madvise

# thp_defrag: madvise - how long a fault waits for a free 2 MiB block
w /sys/kernel/mm/transparent_hugepage/defrag - - - - madvise"
`;

exports[`generated config: hugepages > database / thp-always 1`] = `
"# ────────────────────────────────────────────────────────────────────────────
