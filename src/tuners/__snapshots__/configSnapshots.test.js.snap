#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-kernel-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify they took effect:
#      sysctl kernel.keys.maxkeys kernel.keys.maxbytes kernel.panic kernel.panic_on_oops kernel.softlockup_panic kernel.sysrq kernel.printk
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-kernel-tuning.conf
#
# NOTES
#
# kernel.pid_max is left out: systemd 243 and newer raise it to
# 4194304, the most the kernel takes on 64-bit, at boot.
#
# kernel.threads-max is left out at the kernel's own value, about
# one thread per 128 KiB of RAM.
#
# kernel.panic decides whether a panic ends in a reboot, including the
# panics vm.panic_on_oom asks for.
#
# kernel.sysrq covers the keyboard and serial console only: root can
# trigger every function through /proc/sysrq-trigger at any setting.
#
# kernel.printk only decides what reaches the console: dmesg and the
# journal keep every message.
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   kernel sysctls: https://docs.kernel.org/admin-guide/sysctl/kernel.html
#   key quotas:     https://docs.kernel.org/security/keys/core.html

# ── Key quotas ──────────────────────────────────────────────────────────────
# maxkeys: 2000 - keys per non-root user
kernel.keys.maxkeys = 2000

# maxbytes: 2000000 - key bytes per non-root user
kernel.keys.maxbytes = 2000000

# ── Panics & SysRq ──────────────────────────────────────────────────────────
# panic: 10 - reboot 10 s after a panic
kernel.panic = 10

# panic_on_oops: 1 - an oops panics
kernel.panic_on_oops = 1

# softlockup_panic: 1 - a soft lockup panics
kernel.softlockup_panic = 1

# sysrq: 176 - SysRq functions allowed (bitmask)
kernel.sysrq = 176

# ── Console ─────────────────────────────────────────────────────────────────
# printk: 4 4 1 7 - console shows levels below 4
kernel.printk = 4 4 1 7"
`;

