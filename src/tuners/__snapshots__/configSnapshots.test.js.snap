# ── inotify file watching ───────────────────────────────────────────────────
# max_user_watches: 1048576 - inotify watches per user, up to about 1.3 GiB of kernel memory
fs.inotify.max_user_watches = 1048576

# max_user_instances: 8192 - inotify instances per user
fs.inotify.max_user_instances = 8192

# max_queued_events: 131072 - events queued per inotify instance before overflow
fs.inotify.max_queued_events = 131072

# ── Asynchronous I/O ────────────────────────────────────────────────────────
# aio_max_nr: 65536 - native AIO requests across all processes
fs.aio-max-nr = 65536"
`;

