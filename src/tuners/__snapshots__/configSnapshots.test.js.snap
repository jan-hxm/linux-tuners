exports[`generated config: systemd > container-host / container-host 1`] = `
"# systemd resource tuning (generated 2026-01-01)
# Profile: container host, system.slice, 16 GiB RAM, 8 cores, cgroup v2
# Preset: Container host
# Apply: sudo systemctl daemon-reload
#        manager defaults also need: sudo systemctl daemon-reexec (or a reboot)
# Sources:
#   https://www.freedesktop.org/software/systemd/man/latest/systemd-system.conf.html
#   https://www.freedesktop.org/software/systemd/man/latest/systemd.resource-control.html

# ===== /etc/systemd/system.conf.d/99-resource-tuning.conf ===================
[Manager]
# DefaultCPUAccounting: per-unit CPU time accounting
DefaultCPUAccounting=yes
# DefaultMemoryAccounting: per-unit memory accounting (required for memory limits)
DefaultMemoryAccounting=yes
# DefaultIOAccounting: per-unit block-I/O accounting
DefaultIOAccounting=yes
# DefaultTasksAccounting: per-unit task counting (required for TasksMax)
DefaultTasksAccounting=yes
# DefaultIPAccounting: per-unit network accounting (eBPF)
DefaultIPAccounting=no
# DefaultTasksMax: default per-unit task cap (~25% of pid_max)
DefaultTasksMax=1048576
# DefaultLimitNOFILE: default open-file-descriptor soft:hard limit
DefaultLimitNOFILE=1024:1048576
# DefaultLimitMEMLOCK: default locked-in-memory ceiling
DefaultLimitMEMLOCK=8M

# ===== /etc/systemd/system/system.slice.d/50-resources.conf =================
[Slice]
# CPUWeight: proportional CPU share under contention (default 100)
CPUWeight=100
# CPUQuota: unset (no hard CPU limit)
# MemoryHigh: soft throttle limit ≈ 12.8 GiB of 16
MemoryHigh=80%
# MemoryMax: hard OOM limit ≈ 14.4 GiB of 16
MemoryMax=90%
# MemorySwapMax: unset (infinity, slice may swap freely)
# IOWeight: proportional block-I/O share under contention (default 100)
IOWeight=100
# TasksMax: hard task cap for the whole slice (~15% of pid_max)
TasksMax=629146"
`;

exports[`generated config: systemd > container-host / database-server 1`] = `
