#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-security-hardening.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#    Test on one machine first: some values can break debuggers,
#    profilers, VPNs or container networking (see the notes per key).
#
# 3. Verify a value took effect:
#      sysctl kernel.kptr_restrict
#
# ONE-WAY SETTINGS
#
# These can't be changed again until the next reboot once applied:
#   kernel.yama.ptrace_scope = 3
#   kernel.unprivileged_bpf_disabled = 1
# To undo them, remove the lines from this file and reboot.
#
# ────────────────────────────────────────────────────────────────────────────
#
# NETWORK INTERFACES
#
# The conf.all and conf.default keys below don't reset interfaces that
# already exist when this file is applied, and for redirects the kernel
# honours either value. Check the interface values after applying:
#   sysctl -a 2>/dev/null | grep -E '\\.(rp_filter|accept_redirects|send_redirects)'
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   Kernel sysctl docs: https://docs.kernel.org/admin-guide/sysctl/
#   IP sysctls: https://docs.kernel.org/networking/ip-sysctl.html
#   KSPP recommended settings: https://kspp.github.io/Recommended_Settings

# ── Kernel information and attack surface ───────────────────────────────────
# kptr_restrict: 2 - kernel pointers hidden from everyone
kernel.kptr_restrict = 2

# dmesg_restrict: 1 - kernel log needs CAP_SYSLOG
kernel.dmesg_restrict = 1

# perf_event_paranoid: 3 - no unprivileged perf on patched kernels, otherwise same as 2
kernel.perf_event_paranoid = 3

# ptrace_scope: 3 - ptrace disabled, locked until reboot
kernel.yama.ptrace_scope = 3

# randomize_va_space: 2 - full ASLR
kernel.randomize_va_space = 2

# unprivileged_bpf_disabled: 1 - unprivileged bpf() off, locked until reboot
kernel.unprivileged_bpf_disabled = 1

# ── Network ─────────────────────────────────────────────────────────────────
# rp_filter: 2 - loose reverse-path filtering
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2

# tcp_syncookies: 1 - SYN cookies when the listen queue overflows
net.ipv4.tcp_syncookies = 1

# accept_redirects: 0 - ignore ICMP redirects
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# accept_redirects_v6: 0 - ignore ICMP redirects
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0

# send_redirects: 0 - never send ICMP redirects
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

# accept_source_route: 0 - drop source-routed packets
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0

# ── Filesystem links and core dumps ─────────────────────────────────────────
# protected_symlinks: 1 - restrict following symlinks in sticky dirs
fs.protected_symlinks = 1

# protected_hardlinks: 1 - restrict hard links to others' files
fs.protected_hardlinks = 1

# protected_fifos: 2 - protect FIFOs in group-writable sticky dirs too
fs.protected_fifos = 2

# protected_regular: 2 - protect files in group-writable sticky dirs too
fs.protected_regular = 2

# suid_dumpable: 0 - no core dumps of privileged processes
fs.suid_dumpable = 0"
`;

