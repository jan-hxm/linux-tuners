"# ────────────────────────────────────────────────────────────────────────────
# Linux swap & VM sysctl tuning
# Generated 2026-01-01 by linux-tuners.dev/swap
# Hardware: 16 GiB RAM, 8 GiB NVMe swap, embedded / constrained
# Profile: Database server
# ────────────────────────────────────────────────────────────────────────────
#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-swap-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify a value took effect:
#      sysctl vm.swappiness
#
# ACTIVATING SWAP: 8 GiB on NVMe
#
# If you do not have swap yet, a swap file is the simplest option:
#   sudo fallocate -l 8G /swapfile        # fallback: sudo dd if=/dev/zero of=/swapfile bs=1M count=8192
#   sudo chmod 600 /swapfile
#   sudo mkswap /swapfile
#   sudo swapon /swapfile
#
# Persist it across reboots by adding it to /etc/fstab:
#   echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
#
# Confirm it is active:  swapon --show && free -h
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   Kernel vm docs: https://docs.kernel.org/admin-guide/sysctl/vm.html

# ── Memory reclaim & swap ───────────────────────────────────────────────────
# swappiness: 1 - low swap aggressiveness, prioritise latency
vm.swappiness = 1

# min_free_kbytes: 67109 - reserve ~66 MiB as the kernel free-memory floor
vm.min_free_kbytes = 67109

# watermark_scale_factor: 10 - kswapd reclaim window ~16 MiB wide
vm.watermark_scale_factor = 10

# vfs_cache_pressure: 50 - prefer keeping filesystem metadata in cache
vm.vfs_cache_pressure = 50

# ── Dirty page writeback ────────────────────────────────────────────────────
# dirty_ratio: 5 - synchronous stall ceiling at 5% of available memory dirtied
vm.dirty_ratio = 5

# dirty_background_ratio: 2 - background flusher wakes at 2% of available memory dirtied
vm.dirty_background_ratio = 2

# dirty_expire_centisecs: 500 - dirty pages eligible for flush after 5.0 s
vm.dirty_expire_centisecs = 500

# dirty_writeback_centisecs: 100 - flusher wakes every 1.0 s
vm.dirty_writeback_centisecs = 100

# ── OOM & overcommit ────────────────────────────────────────────────────────
# overcommit_memory: 0 - heuristic, kernel default
vm.overcommit_memory = 0

# panic_on_oom: 0 - invoke OOM killer (default)
vm.panic_on_oom = 0"
`;

