#
# HOW TO APPLY THESE SETTINGS
#
# 1. Persist them. Save this whole file as a drop-in (sysctl ignores
#    the comment lines, and any *.conf in /etc/sysctl.d/ loads on boot):
#      sudo nano /etc/sysctl.d/99-network-tuning.conf   # then paste this file
#
# 2. Apply them now, without rebooting:
#      sudo sysctl --system
#
# 3. Verify a value took effect:
#      sysctl net.ipv4.tcp_rmem
#
# To undo, delete this file and reboot. The values already applied stay
# set until the reboot:
#      sudo rm /etc/sysctl.d/99-network-tuning.conf
#
# NOTES
#
# default_qdisc reaches interfaces created after it is set. Existing
# ones keep theirs until a reboot, or apply it now per interface
# (replace eth0 with each interface name from ip link):
#   sudo tc qdisc replace dev eth0 root fq_codel
#
# The net.netfilter keys exist only once nf_conntrack is loaded. At boot
# that can happen after this file is applied, and the keys are then
# skipped. Load the module first:
#   echo nf_conntrack | sudo tee /etc/modules-load.d/nf_conntrack.conf
# Before kernel 4.19 the TCP timeout keys come with nf_conntrack_ipv4:
#   echo nf_conntrack_ipv4 | sudo tee -a /etc/modules-load.d/nf_conntrack.conf
# nf_conntrack_buckets can only be written from the host, not from
# inside a container.
#
# ────────────────────────────────────────────────────────────────────────────
#
# Sources:
#   IP sysctls: https://docs.kernel.org/networking/ip-sysctl.html
#   net.core sysctls: https://docs.kernel.org/admin-guide/sysctl/net.html
#   Conntrack sysctls: https://docs.kernel.org/networking/nf_conntrack-sysctl.html

# ── Socket buffers ──────────────────────────────────────────────────────────
# rmem_max: 67108864 - SO_RCVBUF requests capped at 64 MiB
net.core.rmem_max = 67108864

# wmem_max: 67108864 - SO_SNDBUF requests capped at 64 MiB
net.core.wmem_max = 67108864

# tcp_rmem: 4096 131072 67108864 - TCP receive buffer 4 KiB / 128 KiB / 64 MiB (min / start / autotune max)
net.ipv4.tcp_rmem = 4096 131072 67108864

# tcp_wmem: 4096 16384 67108864 - TCP send buffer 4 KiB / 16 KiB / 64 MiB (min / start / autotune max)
net.ipv4.tcp_wmem = 4096 16384 67108864

# ── Connection queues ───────────────────────────────────────────────────────
# somaxconn: 65535 - accept queue ceiling per listener
net.core.somaxconn = 65535

# tcp_max_syn_backlog: 65535 - half-open connections per listener
net.ipv4.tcp_max_syn_backlog = 65535

# netdev_max_backlog: 8192 - received packets queued per CPU
net.core.netdev_max_backlog = 8192

# ── TCP behaviour and queueing ──────────────────────────────────────────────
# tcp_congestion_control: cubic - congestion control for new connections
net.ipv4.tcp_congestion_control = cubic

# default_qdisc: fq_codel - qdisc for interfaces created from now on
net.core.default_qdisc = fq_codel

# tcp_slow_start_after_idle: 0 - keep the congestion window across idle pauses
net.ipv4.tcp_slow_start_after_idle = 0

# tcp_mtu_probing: 0 - no packetization-layer MTU probing
net.ipv4.tcp_mtu_probing = 0

# ── Connections and local ports ─────────────────────────────────────────────
# tcp_tw_reuse: 1 - reuse TIME_WAIT ports for outgoing connections
net.ipv4.tcp_tw_reuse = 1

# tcp_fin_timeout: 15 - seconds an orphaned socket waits in FIN_WAIT_2
net.ipv4.tcp_fin_timeout = 15

# ip_local_port_range: 16384 65535 - 49152 local ports for outgoing connections
net.ipv4.ip_local_port_range = 16384 65535

# ── Connection tracking (netfilter) ─────────────────────────────────────────
# nf_conntrack_max: 262144 - tracked connections, about 80 MiB when full
net.netfilter.nf_conntrack_max = 262144

# nf_conntrack_buckets: 262144 - conntrack hash table size
net.netfilter.nf_conntrack_buckets = 262144

# nf_conntrack_tcp_timeout_established: 432000 - seconds an idle established connection stays tracked
net.netfilter.nf_conntrack_tcp_timeout_established = 432000"
`;

